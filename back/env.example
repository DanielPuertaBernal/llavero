# Copia este archivo como .env (en el mismo directorio, back/) y completa
# los valores reales. .env nunca se commitea (ver back/.gitignore).

DEBUG=True
SECRET_KEY=

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes del frontend autorizados vía CORS (lista separada por comas, ver
# CORS_ALLOWED_ORIGINS en settings.py). Comentada a propósito, no vacía:
# django-environ trata una variable presente-pero-vacía como lista vacía
# (bloquea todo), no como "usar el default" — dejarla sin descomentar es lo
# que hace que aplique el default de settings.py (http://localhost:4200).
# Descomentala solo si el frontend corre en otro puerto/host, o para agregar
# el dominio real en producción.
# CORS_ALLOWED_ORIGINS=http://localhost:4200

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8080/api/auth/callback
FRONTEND_POST_LOGIN_REDIRECT_URL=http://localhost:4200/auth/callback

# Relay SMTP institucional (mail.uco.edu.co) — usado por el futuro módulo
# notificaciones. Sin cifrado (texto plano, ni SSL ni STARTTLS) y sin
# autenticación: el relay autoriza por IP de origen, no por credenciales,
# por eso EMAIL_HOST_USER/EMAIL_HOST_PASSWORD quedan vacíos a propósito.
EMAIL_HOST=mail.uco.edu.co
EMAIL_HOST_FALLBACK=172.16.1.6
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=no-reply@uco.edu.co

# Clave compartida del endpoint protegido POST /api/scheduler/ejecutar-transiciones
# (header X-Scheduler-Api-Key, ver scheduler/security.py). Vacío por defecto:
# mientras no se configure, el endpoint responde 401 siempre (fail-closed).
SCHEDULER_API_KEY=

# Email institucional del primer usuario admin. Al correr `migrate` sobre una
# base de datos nueva, la migración usuarios.0002_seed_superusuario_inicial
# crea (si no existe ya) un Usuario con rol "admin" y este email, para poder
# iniciar sesión por primera vez con Office 365 (que vincula por
# email_institucional, ver usuarios/model.py). Vacío por defecto: si no se
# configura, la migración no crea ningún usuario.
SUPERUSUARIO_EMAIL=