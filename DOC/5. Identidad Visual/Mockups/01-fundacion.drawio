        <mxCell id="lg-footnote" value="&#191;No pod&#233;s ingresar? Contact&#225; al administrador del sistema para que precree tu usuario." style="text;html=1;align=left;verticalAlign=top;fontFamily=Montserrat;fontSize=11;fontColor=#6b7280;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
