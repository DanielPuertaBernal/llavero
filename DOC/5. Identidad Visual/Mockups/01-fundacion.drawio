        </mxCell>
        <mxCell id="lg-app-desc" value="Sistema de gesti&#243;n de llaves, equipos y salones. Reemplaza el control manual por trazabilidad completa de pr&#233;stamos, reservas y disponibilidad." style="text;html=1;align=left;verticalAlign=top;fontFamily=Montserrat;fontSize=14;fontColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1">
